# Core
PADDLE_DEVICE=cpu
MODEL_LANG=en
MAX_IMAGE_SIZE_MB=20
MAX_IMAGE_PIXELS=16777216
MAX_BATCH_SIZE=20

# OCR Engine
DET_DB_THRESH=0.3
DET_DB_BOX_THRESH=0.5
REC_BATCH_NUM=6
USE_ANGLE_CLS=true
LAYOUT_ANALYSIS=false
TABLE_DETECTION=false
MIN_CONFIDENCE=0.0
INCLUDE_POLYGON=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=INFO

# Jobs
JOB_BACKEND=filesystem
JOB_DIR=/tmp/ocr_jobs
JOB_TTL_HOURS=24
