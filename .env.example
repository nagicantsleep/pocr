# Core
PADDLE_DEVICE=cpu
MODEL_LANG=en
MAX_IMAGE_SIZE_MB=20
MAX_IMAGE_PIXELS=16777216
MAX_BATCH_SIZE=20

# OCR Engine
DET_DB_THRESH=0.3
DET_DB_BOX_THRESH=0.5
REC_BATCH_NUM=6
USE_ANGLE_CLS=true
LAYOUT_ANALYSIS=false
TABLE_DETECTION=false
MIN_CONFIDENCE=0.0
INCLUDE_POLYGON=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=INFO

# Tenant-aware operator authentication. Production requires OPERATOR_TOKEN_MAP.
# Example: {"token-a":{"tenant_id":"tenant-a","user_id":"reviewer-a","roles":["operator","reviewer"]}}
OPERATOR_ENVIRONMENT=development
OPERATOR_TOKEN_MAP={}
# Temporary migration only; production additionally requires OPERATOR_ALLOW_LEGACY_TOKEN=true.
OPERATOR_BEARER_TOKEN=
OPERATOR_ALLOW_LEGACY_TOKEN=false

# Jobs
JOB_BACKEND=filesystem
JOB_DIR=/tmp/ocr_jobs
JOB_TTL_HOURS=24

# Structured standardization
# heuristic requires no external service. openrouter uses STANDARDIZER_API_KEY.
STANDARDIZER_PROVIDER=openrouter
STANDARDIZER_MODEL=openrouter/owl-alpha
STANDARDIZER_API_KEY=
STANDARDIZER_BASE_URL=https://openrouter.ai/api/v1
STANDARDIZER_SITE_URL=
STANDARDIZER_APP_NAME=pocr

# Structured async jobs
POSTGRES_DSN=postgresql://pocr:pocr@postgres:5432/pocr
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
STRUCTURED_STANDARDIZE_TOPIC=ocr.standardize
STRUCTURED_STANDARDIZE_RETRY_TOPIC=ocr.standardize.retry
STRUCTURED_STANDARDIZE_DLQ_TOPIC=ocr.standardize.dlq
STRUCTURED_JOB_STALE_SECONDS=300
STANDARDIZER_RATE_LIMIT_KEY=standardizer:openrouter:minute
STANDARDIZER_RATE_LIMIT=20
STANDARDIZER_RATE_LIMIT_TTL_SECONDS=60
STANDARDIZER_RETRYABLE_STATUS_CODES=429,502,503,504
INVOICE_JP_DURABLE_MODE=false
INVOICE_OUTBOX_TOPIC=invoice.events
INVOICE_OUTBOX_CONSUMER_GROUP=pocr-invoice-outbox
INVOICE_OUTBOX_BATCH_SIZE=100
INVOICE_OUTBOX_POLL_SECONDS=1.0

# Object storage. The structured compose profile supplies MinIO defaults.
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage
STORAGE_S3_BUCKET=pocr
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# Invoice extraction
INVOICE_ENABLE_EXTRACTION=true
INVOICE_DEFAULT_LANG=japan
INVOICE_REVIEW_THRESHOLD=0.85
INVOICE_INCLUDE_OCR=false
INVOICE_MAX_AUTO_APPROVE_AMOUNT=1000000
INVOICE_ENABLE_VENDOR_MATCHING=false
INVOICE_ENABLE_DUPLICATE_CHECK=false
INVOICE_STORAGE_BACKEND=postgres
INVOICE_STORAGE_PATH=./data/invoices
INVOICE_ENABLE_LLM_EXTRACTOR=false
INVOICE_LLM_PROVIDER=
INVOICE_LLM_MODEL=
